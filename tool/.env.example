# UpBain environment variables
# Copy to .env and fill in values before running

# REQUIRED for production
UPBAIN_ADMIN_PASSWORD=your_strong_password_here
UPBAIN_SECRET_KEY=your_32_character_secret_key_here

# Optional — defaults shown
UPBAIN_DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/upbain.db
PORT=8000
HOST=127.0.0.1
SESSION_MAX_AGE=1800

# CORS — comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Live Telegram tests — only enable with test accounts/chats
# LIVE_TELEGRAM_TESTS=1
# TG_TEST_API_ID=
# TG_TEST_API_HASH=
# TG_TEST_PHONE=
# TG_TEST_ALLOWED_CHAT=
